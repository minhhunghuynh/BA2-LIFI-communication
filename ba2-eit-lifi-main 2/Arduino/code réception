def read_integers_from_file(filename):
    integers = []
    try:
        with open(filename, 'r') as file:
            for line in file:
                # Split the line into individual numbers based on spaces
                numbers = line.split()
                # Convert each number to an integer and add to the list
                integers.extend(int(num) for num in numbers)
    except FileNotFoundError:
        print(f"Le fichier {filename} n'a pas été trouvé.")
    except ValueError:
        print("Le fichier contient des valeurs non entières.")
    return integers
syndrome_table = {
    '000': 0,  # no error
    '001': 4,  # error in bit 4
    '010': 5,  # error in bit 5
    '011': 1,  # error in bit 1
    '100': 6,  # error in bit 6
    '101': 2,  # error in bit 2
    '110': 3,  # error in bit 3
    '111': 7,  # error in bit 7
}

def correction_and_extraction(encoded_byte):
    # Extract the bits from LSB to MSB
    p1 = (encoded_byte >> 6) & 1
    p2 = (encoded_byte >> 5) & 1
    d1 = (encoded_byte >> 4) & 1
    p4 = (encoded_byte >> 3) & 1
    d2 = (encoded_byte >> 2) & 1
    d3 = (encoded_byte >> 1) & 1
    d4 = encoded_byte & 1

    bits = [d4,d3,d2,p4,d1,p2,p1]
    # Compute syndrome bits
    c1 = p1 ^ d1 ^ d2 ^ d4
    c2 = p2 ^ d1 ^ d3 ^ d4
    c4 = p4 ^ d2 ^ d3 ^ d4

    # Convert syndrome to a string properly
    syndrome = f'{c4}{c2}{c1}' # Correction ici : ordre correct pour correspondre au tableau

    error_position = syndrome_table[syndrome]
    if error_position != 0:
        bits[error_position - 1] ^= 1  # Correction du bit erroné
        p1, p2, d1, p4, d2, d3, d4 = bits
    # Reconstruct data bits
    data_bits = (d1 << 3) | (d2 << 2) | (d3 << 1) | d4
    return data_bits

def group_decoded_bits(encoded_bytes):
    grouped_bytes = []
    for i in range(0, len(encoded_bytes), 2):
        if i+1 < len(encoded_bytes):
            # Combine two 4-bit values into one byte
            lc = correction_and_extraction(encoded_bytes[i])
            mc = correction_and_extraction((encoded_bytes[i+1]))
            combined_byte = (mc << 4) | lc
            grouped_bytes.append(combined_byte)
    return grouped_bytes
