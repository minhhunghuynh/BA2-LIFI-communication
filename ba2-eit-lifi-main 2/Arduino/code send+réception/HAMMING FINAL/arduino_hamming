//convert the word send to binary LSB-first

String getLSBBinary(String text) {
    String lsbBinary = "11";

    for (int i = 0; i < text.length(); i++) {
        char c = text[i];            
        byte binary = c;              
        String bitStr = "10";
        // Extract bits LSB-first
        for (int j = 0; j < 8; j++) {
            bitStr += (binary & (1 << j)) ? '1' : '0';  
        }

        lsbBinary += bitStr + "";
     
    }
   lsbBinary+="11";
  return lsbBinary;
}



//receieve the whole image data

void receieveImage() {
 
 
   bitDelaytime = micros();
  //wait for start bit
    for (;;) {
   bitDelaytime+= Delay/4;
    while (micros() < bitDelaytime);
 
    if (digitalRead(readPin) != 1) {
        break;
    }
}
     
   bitDelaytime+= Delay;
    while (micros() < bitDelaytime);
 
    for (int i = 0; i < 8; i++) {
        bit = digitalRead(readPin);
        ImageByte |= (bit << i);
        bitDelaytime += Delay;
       while (micros() < bitDelaytime);
    }
    Serial.write(ImageByte);
    ImageByte= 0;

    //wait until stop bit
for(;;) {
  bitDelaytime+= Delay/4;
    while (micros() < bitDelaytime);
   if(digitalRead(readPin) != 1)
       break;
}
   
 
    return;
}


