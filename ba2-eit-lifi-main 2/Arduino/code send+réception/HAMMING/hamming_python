def display_image_from_list(data):
    # Vérifier le préambule
    preamble = data[:3]
    if bytes(preamble) != b'IMG':
        raise ValueError('Préambule incorrect')

    # Lire les dimensions de l'image
    width = data[3]
    height = data[4]

    # Lire la palette de couleurs
    palette = []
    index = 5
    for i in range(256):
        r = data[index]
        g = data[index + 1]
        b = data[index + 2]
        palette.append((r, g, b))
        index += 3

    # Lire les pixels de l'image
    pixels = []
    for i in range(width * height):
        color_index = data[index]
        pixels.append(palette[color_index])
        index += 1

    # Créer une image vide de dimensions height x width avec 3 canaux de couleur (RGB)
    img = np.zeros((height, width, 3), dtype=np.uint8)

    # Remplir l'image avec les pixels reçus
    for y in range(height):
        for x in range(width):
            img[y, x] = pixels[y * width + x]

    # Afficher l'image
    plt.imshow(img)
    plt.title(f"Image {width}x{height}")
    plt.axis('off')  # Masquer les axes
    plt.show()

def correction_and_extraction(encoded_byte):
    # Extract the bits from LSB to MSB
    p1 = (encoded_byte >> 6) & 1
    p2 = (encoded_byte >> 5) & 1
    d1 = (encoded_byte >> 4) & 1
    p4 = (encoded_byte >> 3) & 1
    d2 = (encoded_byte >> 2) & 1
    d3 = (encoded_byte >> 1) & 1
    d4 = encoded_byte & 1

    bits = [d4,d3,d2,p4,d1,p2,p1]
    # Compute syndrome bits
    c1 = p1 ^ d1 ^ d2 ^ d4
    c2 = p2 ^ d1 ^ d3 ^ d4
    c4 = p4 ^ d2 ^ d3 ^ d4

    # Convert syndrome to a string properly
    syndrome = f'{c4}{c2}{c1}' # Correction ici : ordre correct pour correspondre au tableau

    error_position = syndrome_table[syndrome]
    if error_position != 0:
        bits[error_position - 1] ^= 1  # Correction du bit erroné
        p1, p2, d1, p4, d2, d3, d4 = bits
    # Reconstruct data bits
    data_bits = (d1 << 3) | (d2 << 2) | (d3 << 1) | d4
    return data_bits

def group_decoded_bits(encoded_bytes):
    grouped_bytes = []
    for i in range(0, len(encoded_bytes), 2):
        if i+1 < len(encoded_bytes):
            # Combine two 4-bit values into one byte
            lc = correction_and_extraction(encoded_bytes[i])
            mc = correction_and_extraction((encoded_bytes[i+1]))
            combined_byte = (mc << 4) | lc
            grouped_bytes.append(combined_byte)
    return grouped_bytes



