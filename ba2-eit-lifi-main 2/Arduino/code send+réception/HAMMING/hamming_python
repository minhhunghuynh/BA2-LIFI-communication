def read_integers_from_file(filename):
    integers = []
    try:
        with open(filename, 'r') as file:
            for line in file:
                # Split the line into individual numbers based on spaces
                numbers = line.split()
                # Convert each number to an integer and add to the list
                integers.extend(int(num) for num in numbers)
    except FileNotFoundError:
        print(f"Le fichier {filename} n'a pas été trouvé.")
    except ValueError:
        print("Le fichier contient des valeurs non entières.")
    return integers

