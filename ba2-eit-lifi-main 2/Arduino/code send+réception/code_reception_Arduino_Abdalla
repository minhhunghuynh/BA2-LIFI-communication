void ControlCircuitLeds(const String& send_str, unsigned long delayTime){
  delayPeriod=micros();
  delayPeriod+=delayTime/4;
  for(char bit : send_str)
  {
    while(micros() < delayPeriod);
    if(bit == '1')
    {
      digitalWrite(ledPin,HIGH);

    }
     if(bit == '0')
    {
      digitalWrite(ledPin,LOW);
      
    }
    delayPeriod +=delayTime;
  }
}
